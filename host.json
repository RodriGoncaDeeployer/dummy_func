{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Debug",
      "Host.Aggregator": "Trace",
      "Host.Results": "Debug",
      "Function": "Debug"
    },
    "console": {
      "isEnabled": true
    }
},
  "telemetryMode": "OpenTelemetry",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "extensions": {},
  "concurrency": {
    "dynamicConcurrencyEnabled": false,
    "snapshotPersistenceEnabled": false
  },
  "functionTimeout": "00:05:00"
}